# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Administrative Passkey for Studio Ledger & Website Management
# Default: aperture2026 (change in production)
ADMIN_PASSKEY=aperture2026

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/aperture_and_ash
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/aperture_and_ash?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/aperture_and_ash

# Client CORS Configuration
CLIENT_URL=http://localhost:5173
